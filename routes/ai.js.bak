/**
 * AI ROUTE — Real Claude API with full health context + location
 */
const express = require('express');
const router = express.Router();
const { v4: uuidv4 } = require('uuid');
const { readDB, writeDB } = require('../utils/db');
const { analyzeHealthData } = require('../utils/aiEngine');

const buildSystemPrompt = (db, location) => {
  const { profile, healthLogs = [], goals = [], streaks = {}, routineAnalyses = [] } = db;
  const now = new Date();
  const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
  const dateStr = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
  const hourNow = now.getHours();
  const last7 = healthLogs.slice(-7);

  const avg = (key) => {
    const vals = last7.map(l => l[key]).filter(v => v > 0 && v != null);
    return vals.length ? (vals.reduce((s, v) => s + v, 0) / vals.length).toFixed(1) : null;
  };

  const avgSleep = avg('sleep');
  const avgWater = avg('water');
  const avgMood = avg('mood');
  const activeDays = last7.filter(l => l.exercise?.duration > 0).length;
  const totalExMin = last7.reduce((s, l) => s + (l.exercise?.duration || 0), 0);
  const latestWt = [...healthLogs].reverse().find(l => l.weight)?.weight;

  const weightTrend = (() => {
    const wts = healthLogs.filter(l => l.weight).slice(-10).map(l => l.weight);
    if (wts.length < 2) return 'not enough data';
    const diff = wts[wts.length - 1] - wts[0];
    return diff > 0.5 ? `gaining (+${diff.toFixed(1)} kg over ${wts.length} entries)` :
           diff < -0.5 ? `losing (-${Math.abs(diff).toFixed(1)} kg over ${wts.length} entries)` : 'stable';
  })();

  const palMap = { sedentary: 1.2, light: 1.375, moderate: 1.55, active: 1.725, very_active: 1.9 };
  let bmi = null, bmr = null, tdee = null, bmiLabel = null;
  if (profile) {
    bmi = (profile.weight / Math.pow(profile.height / 100, 2)).toFixed(1);
    bmr = profile.gender === 'male'
      ? Math.round(10 * profile.weight + 6.25 * profile.height - 5 * profile.age + 5)
      : Math.round(10 * profile.weight + 6.25 * profile.height - 5 * profile.age - 161);
    tdee = Math.round(bmr * (palMap[profile.activityLevel] || 1.55));
    bmiLabel = bmi < 18.5 ? 'Underweight' : bmi < 25 ? 'Normal' : bmi < 30 ? 'Overweight' : 'Obese';
  }

  const mealSummary = last7.filter(l => l.meals?.length > 0).slice(-3).map(l => {
    const cal = l.meals.reduce((s, m) => s + (m.calories || 0), 0);
    const prot = l.meals.reduce((s, m) => s + (m.protein || 0), 0);
    return `  * ${new Date(l.date).toLocaleDateString('en-US', { weekday: 'short' })}: ${cal} kcal, ${prot}g protein — ${l.meals.map(m => m.name).join(', ')}`;
  }).join('\n') || '  No meals logged recently.';

  const logTable = healthLogs.slice(-7).map(l => {
    const cal = (l.meals || []).reduce((s, m) => s + (m.calories || 0), 0);
    return `  ${new Date(l.date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })}: sleep=${l.sleep || '-'}h water=${l.water || '-'}L weight=${l.weight || '-'}kg exercise=${l.exercise?.duration || 0}min mood=${l.mood || '-'}/10 calories=${cal || '-'}kcal`;
  }).join('\n') || '  No log entries yet.';

  const lastRoutine = routineAnalyses?.[0];
  const activeGoals = goals.filter(g => !g.achieved);

  return `You are VitaAI, an expert AI health and lifestyle coach inside a personal health tracking app.
You have COMPLETE access to the user's health profile, daily logs, goals, and real-time location.
Give evidence-based, hyper-personalized advice using the user's ACTUAL numbers — never generic advice.

=== RIGHT NOW ===
Date: ${dateStr}
Time: ${timeStr} (${hourNow < 12 ? 'morning' : hourNow < 17 ? 'afternoon' : hourNow < 21 ? 'evening' : 'night'})
Location: ${location?.city || 'Unknown'}, ${location?.region || ''}, ${location?.country || 'Unknown'}
Timezone: ${location?.timezone || 'Unknown'}
Coordinates: ${location?.lat ? `${Number(location.lat).toFixed(3)}, ${Number(location.lon).toFixed(3)}` : 'Not available'}

=== USER PROFILE ===
${profile ? `Name: ${profile.name || 'Not set'} | Age: ${profile.age} | Gender: ${profile.gender}
Height: ${profile.height} cm | Weight: ${profile.weight} kg | Activity: ${profile.activityLevel}
BMI: ${bmi} (${bmiLabel}) | BMR: ${bmr} kcal/day | TDEE: ${tdee} kcal/day
Water target: ${profile ? (profile.weight * 0.033).toFixed(1) : '-'} L/day` : 'No profile set. Encourage profile setup.'}

=== LAST 7 DAYS SUMMARY ===
Sleep: avg ${avgSleep || '-'} hrs/night ${avgSleep ? (avgSleep >= 7 ? '[GOOD]' : avgSleep >= 6 ? '[LOW]' : '[CRITICAL]') : ''}
Water: avg ${avgWater || '-'} L/day
Mood: avg ${avgMood || '-'}/10
Exercise: ${activeDays}/7 active days | ${totalExMin} total minutes ${totalExMin >= 150 ? '[WHO TARGET MET]' : `[${150 - totalExMin} min short of WHO 150min target]`}
Weight: latest ${latestWt || '-'} kg | trend: ${weightTrend}

Recent Meals:
${mealSummary}

Log Table:
${logTable}

=== ACTIVE GOALS (${activeGoals.length}) ===
${activeGoals.length > 0
  ? activeGoals.map(g => `- ${g.type.replace(/_/g, ' ')}: target ${g.target} ${g.unit || ''} | current ${g.currentValue ?? '?'} | ${g.progress || 0}% done${g.deadline ? ` | deadline ${new Date(g.deadline).toLocaleDateString()}` : ''}`).join('\n')
  : 'No active goals.'}

=== STREAKS ===
Current: ${streaks.currentStreak || 0} days | Best: ${streaks.longestStreak || 0} days | Total logged: ${streaks.totalLoggedDays || 0} days

=== LAST ROUTINE ANALYSIS ===
${lastRoutine ? `Score: ${lastRoutine.analysis?.routineScore}/100 | Issues: ${lastRoutine.analysis?.issues?.map(i => i.title).join(', ') || 'None'} | Analyzed: ${new Date(lastRoutine.createdAt).toLocaleDateString()}` : 'No routine analyzed yet.'}

=== COACHING RULES ===
1. ALWAYS cite the user's actual numbers. Never give generic advice without referencing their data.
2. Be LOCATION-AWARE: use their city (${location?.city || 'unknown'}), current time, and season in your advice.
3. Give ONE concrete action they can take RIGHT NOW given the time (${timeStr}) and location.
4. Time-of-day context: ${hourNow < 6 ? 'middle of the night — focus on sleep' : hourNow < 12 ? 'morning — energize, breakfast, movement' : hourNow < 17 ? 'afternoon — sustain energy, hydration' : hourNow < 21 ? 'evening — wind down, light dinner, recovery' : 'night — prioritize sleep, no screens'}.
5. Reference their ${streaks.currentStreak || 0}-day streak when motivating consistency.
6. Use **bold** for key numbers. Bullet points for lists. Be concise and actionable.
7. If data is missing, acknowledge it and suggest they log it.
8. Never diagnose medical conditions. For serious symptoms, recommend a doctor.
9. Address the user as ${profile?.name || 'there'} when natural.`;
};

const callClaude = async (messages, systemPrompt) => {
  const apiKey = process.env.ANTHROPIC_API_KEY;
  if (!apiKey) throw new Error('ANTHROPIC_API_KEY not set in backend/.env');

  const response = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'x-api-key': apiKey,
      'anthropic-version': '2023-06-01'
    },
    body: JSON.stringify({
      model: 'claude-sonnet-4-20250514',
      max_tokens: 1024,
      system: systemPrompt,
      messages: messages.map(m => ({ role: m.role, content: m.content }))
    })
  });

  if (!response.ok) {
    const err = await response.json().catch(() => ({}));
    throw new Error(err?.error?.message || `HTTP ${response.status}`);
  }
  const data = await response.json();
  return data.content?.[0]?.text || 'No response generated.';
};

// POST /api/ai/chat
router.post('/chat', async (req, res) => {
  const { message, location } = req.body;
  if (!message?.trim()) return res.status(400).json({ error: 'Message required' });

  const db = readDB();
  const history = (db.chatHistory || [])
    .filter(m => m.role === 'user' || m.role === 'assistant')
    .slice(-20)
    .map(m => ({ role: m.role, content: m.content }));

  try {
    const aiText = await callClaude([...history, { role: 'user', content: message }], buildSystemPrompt(db, location));

    const userMsg = { id: uuidv4(), role: 'user', content: message, location: location || null, timestamp: new Date().toISOString() };
    const asstMsg = { id: uuidv4(), role: 'assistant', content: aiText, timestamp: new Date().toISOString() };

    db.chatHistory = (db.chatHistory || []);
    db.chatHistory.push(userMsg, asstMsg);
    if (db.chatHistory.length > 100) db.chatHistory = db.chatHistory.slice(-100);
    writeDB(db);

    res.json({
      response: aiText,
      timestamp: asstMsg.timestamp,
      contextUsed: { hasProfile: !!db.profile, logsCount: (db.healthLogs || []).length, location: location?.city || 'unknown' }
    });
  } catch (err) {
    console.error('Claude API error:', err.message);
    let msg = 'AI service error. Please try again.';
    if (err.message.includes('ANTHROPIC_API_KEY')) msg = 'API key not found. Add ANTHROPIC_API_KEY to backend/.env and restart.';
    else if (err.message.includes('401') || err.message.includes('authentication')) msg = 'Invalid API key. Check ANTHROPIC_API_KEY in backend/.env';
    else if (err.message.includes('429')) msg = 'Rate limit reached. Please wait a moment.';
    res.status(500).json({ error: msg });
  }
});

// POST /api/ai/daily-summary
router.post('/daily-summary', async (req, res) => {
  const { location } = req.body;
  const db = readDB();
  const hourNow = new Date().getHours();
  const period = hourNow < 12 ? 'morning' : hourNow < 17 ? 'afternoon' : 'evening';

  try {
    const summary = await callClaude([{
      role: 'user',
      content: `Give me a short personalized ${period} health check-in using my actual data:
1. One sentence overall status with a specific metric
2. My single most important focus right now
3. One action I can do in the next 10 minutes (it's ${new Date().toLocaleTimeString()} in ${location?.city || 'my city'})
Keep it under 80 words. Use my real numbers. Be encouraging.`
    }], buildSystemPrompt(db, location));
    res.json({ summary, generatedAt: new Date().toISOString() });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

router.get('/history', (req, res) => {
  const db = readDB();
  res.json((db.chatHistory || []).slice(-50));
});

router.delete('/history', (req, res) => {
  const db = readDB();
  db.chatHistory = [];
  writeDB(db);
  res.json({ success: true });
});

router.get('/suggestions', (req, res) => {
  const db = readDB();
  const { insights, suggestions, warnings, score } = analyzeHealthData(db.profile, db.healthLogs || []);
  res.json({ insights, suggestions, warnings, score, generatedAt: new Date().toISOString() });
});

router.get('/status', (req, res) => {
  const hasKey = !!process.env.ANTHROPIC_API_KEY;
  res.json({
    apiKeyConfigured: hasKey,
    model: 'claude-sonnet-4-20250514',
    message: hasKey ? 'Claude API ready' : 'Add ANTHROPIC_API_KEY to backend/.env'
  });
});

module.exports = router;
